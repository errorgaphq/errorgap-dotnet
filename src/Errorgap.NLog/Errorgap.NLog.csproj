<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Errorgap.NLog</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>NLog target for Errorgap: reports error events and sends logs.</Description>
    <PackageTags>errorgap;nlog;target;error-tracking;logging</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.4" />
    <ProjectReference Include="..\Errorgap\Errorgap.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
