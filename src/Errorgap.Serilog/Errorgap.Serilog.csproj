<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Errorgap.Serilog</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Serilog sink for Errorgap: reports error events and sends logs.</Description>
    <PackageTags>errorgap;serilog;sink;error-tracking;logging</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="3.1.1" />
    <ProjectReference Include="..\Errorgap\Errorgap.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
